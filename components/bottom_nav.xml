<!--
  Shared footer nav bar present on every screen: 5 circular icon buttons that
  jump straight to the 5 "feature" screens, matching the row of icons at the
  bottom of every prototype image.
-->
<component>
  <styles>
    <style name="style_dot_btn" radius="180" width="70" height="70" bg_opa="100%" border_width="0" shadow_width="0"/>
    <style name="style_dot_btn_pressed" transform_width="-6" transform_height="-6"/>
    <style name="style_nav_divider" bg_color="#col_text_dim" bg_opa="40%" border_width="0" height="1" width="100%"/>
  </styles>

  <view width="100%" height="96" align="bottom_mid" flex_flow="column" style_bg_opa="0" style_border_width="0" style_pad_all="0" style_pad_row="10" scrollable="false">
    <lv_obj>
      <style name="style_nav_divider"/>
    </lv_obj>

    <lv_obj width="100%" flex_grow="1" style_bg_opa="0" style_border_width="0" scrollable="false">
    <lv_button align="center" x="-274" ignore_layout="true" style_bg_color="#col_purple">
      <style name="style_dot_btn"/>
      <style name="style_dot_btn_pressed" selector="pressed"/>
      <lv_label text="&#62212;" align="center" style_text_color="#col_text" style_text_font="icon_24"/>
      <screen_load_event screen="number_input" trigger="clicked"/>
    </lv_button>

    <lv_button align="center" x="-137" ignore_layout="true" style_bg_color="#col_red">
      <style name="style_dot_btn"/>
      <style name="style_dot_btn_pressed" selector="pressed"/>
      <lv_label text="&#61448;" align="center" style_text_color="#col_text" style_text_font="icon_24"/>
      <screen_load_event screen="animation" trigger="clicked"/>
    </lv_button>

    <lv_button align="center" x="0" ignore_layout="true" style_bg_color="#col_teal">
      <style name="style_dot_btn"/>
      <style name="style_dot_btn_pressed" selector="pressed"/>
      <lv_label text="&#61502;" align="center" style_text_color="#col_text" style_text_font="icon_24"/>
      <screen_load_event screen="icon_cycle" trigger="clicked"/>
    </lv_button>

    <lv_button align="center" x="137" ignore_layout="true" style_bg_color="#col_blue">
      <style name="style_dot_btn"/>
      <style name="style_dot_btn_pressed" selector="pressed"/>
      <lv_label text="&#61641;" align="center" style_text_color="#col_text" style_text_font="icon_24"/>
      <screen_load_event screen="popup_menu" trigger="clicked"/>
    </lv_button>

    <lv_button align="center" x="274" ignore_layout="true" style_bg_color="#col_green">
      <style name="style_dot_btn"/>
      <style name="style_dot_btn_pressed" selector="pressed"/>
      <lv_label text="&#61724;" align="center" style_text_color="#col_text" style_text_font="icon_24"/>
      <screen_load_event screen="text_entry" trigger="clicked"/>
    </lv_button>
    </lv_obj>
  </view>
</component>
